{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:code": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,cts,mts,json,css,scss,mdx,html}\"",
    "lint:all": "pnpm run lint:fix && pnpm run lint && pnpm run format:code",
    "typecheck": "node -e \"require('fs').rmSync('.next/types',{recursive:true,force:true})\" && tsc --noEmit",
    "convex:dev": "node ./scripts/convex-dev.cjs",
    "convex:deploy": "npx convex deploy -y",
    "convex:redeploy": "pnpm run convex:deploy && pnpm run convex:dev",
    "convex:reset": "dotenv -e .env.local -- tsx scripts/reset-convex.ts",
    "vercel:env:sync": "node scripts/sync-vercel-env.cjs",
    "vercel:env:sync:production": "node scripts/sync-vercel-env.cjs production --deploy",
    "vercel:env:sync:preview": "node scripts/sync-vercel-env.cjs preview",
    "vercel:env:sync:development": "node scripts/sync-vercel-env.cjs development",
    "seed:database": "dotenv -e .env.local -- tsx scripts/seed-database.ts",
    "seed:admin-tools": "dotenv -e .env.local -- tsx scripts/seed-admin-tools.ts",
    "contracts:build": "for d in contracts/portal_kubo_*; do (cd \"$d\" && RUSTUP_TOOLCHAIN=1.89.0 cargo contract build --release) || exit 1; done",
    "contracts:deploy": "node scripts/deploy-portaldot-contracts.mjs"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.6",
    "@polkadot/api-contract": "^16.5.6",
    "@polkadot/extension-dapp": "^0.63.1",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scalar/nextjs-api-reference": "^0.10.14",
    "@tailwindcss/postcss": "4.1.7",
    "@tanstack/react-query": "^5.84.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.2",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.1.7",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/node": "^22.17.0",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vercel": "^54.4.1"
  }
}
